---
import { site } from "../data/site";

const year = new Date().getFullYear();

const navLinks = [
  { label: "Inicio", href: "/" },
  { label: "Radios", href: "#radios" },
  { label: "Comandos", href: "#comandos" },
] as const;

const externalLinks = [
  { label: "GitHub", href: site.githubUrl },
  { label: "Ko-fi", href: site.koFiUrl },
] as const;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a class="site-footer__logo" href="/" aria-label="Ir al inicio de radioCL">
        {site.name}
      </a>
      <p>La radio chilena, en tu Discord.</p>
    </div>

    <nav class="site-footer__nav" aria-label="Navegación del pie de página">
      <p>Navegación</p>
      <ul>
        {navLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-footer__nav">
      <p>Externos</p>
      <ul>
        {
          externalLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noreferrer">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>© {year} radioCL</p>
    <p>Hecho en Chile 🇨🇱 con ❤️</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: rgba(5, 11, 28, 0.74);
  }

  .site-footer__inner {
    display: grid;
    gap: 2rem;
    padding-block: 3rem;
  }

  .site-footer__brand {
    max-width: 22rem;
  }

  .site-footer__logo {
    display: inline-flex;
    color: var(--color-text);
    font-size: 1.25rem;
    font-weight: 850;
    letter-spacing: -0.045em;
  }

  .site-footer__brand p {
    margin-top: 0.625rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .site-footer__nav p {
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .site-footer__nav ul {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.875rem;
    padding: 0;
    list-style: none;
  }

  .site-footer__nav a {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .site-footer__nav a:hover {
    color: var(--color-text);
  }

  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 1px solid var(--color-border);
    padding-block: 1.25rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  @media (min-width: 640px) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 1fr) auto auto;
    }

    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
