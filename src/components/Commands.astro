---
import { Terminal } from "@lucide/astro";
import { commands } from "../data/commands";
---

<section class="commands" id="comandos" aria-labelledby="commands-title">
  <div class="container">
    <div class="commands__header">
      <p class="commands__eyebrow">COMANDOS</p>
      <h2 id="commands-title">Controla radioCL desde Discord</h2>
      <p>Comandos slash simples para reproducir, detener y administrar la radio.</p>
    </div>

    <div class="commands__grid">
      {
        commands.map((command) => (
          <article
            class:list={[
              "commands__item",
              command.important && "commands__item--important",
            ]}
          >
            <div class="commands__icon" aria-hidden="true">
              <Terminal size={18} stroke-width={2.25} />
            </div>
            <div>
              <h3><code>{command.name}</code></h3>
              <p>{command.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .commands {
    padding-block: 4rem;
  }

  .commands__header {
    max-width: 43rem;
  }

  .commands__eyebrow {
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .commands__header h2 {
    margin-top: 0.875rem;
    color: var(--color-text);
    font-size: clamp(2rem, 8vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .commands__header > p:last-child {
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 3vw, 1.1875rem);
    line-height: 1.6;
  }

  .commands__grid {
    display: grid;
    gap: 0.875rem;
    margin-top: 2rem;
  }

  .commands__item {
    display: flex;
    gap: 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: rgba(11, 20, 40, 0.58);
    padding: 1rem;
  }

  .commands__item--important {
    border-color: rgba(34, 211, 238, 0.2);
    background: rgba(16, 26, 48, 0.92);
  }

  .commands__icon {
    display: grid;
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid rgba(88, 101, 242, 0.28);
    border-radius: 0.75rem;
    background: rgba(88, 101, 242, 0.1);
    color: var(--color-discord);
  }

  .commands__icon :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .commands__item--important .commands__icon {
    border-color: rgba(34, 211, 238, 0.26);
    background: rgba(34, 211, 238, 0.09);
    color: var(--color-cyan);
  }

  .commands h3 {
    color: var(--color-text);
    font-size: 1.0625rem;
    line-height: 1.2;
  }

  .commands code {
    color: var(--color-cyan);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.95em;
    user-select: text;
  }

  .commands p {
    margin-top: 0.375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .commands__item:not(.commands__item--important) {
    opacity: 0.86;
  }

  @media (min-width: 720px) {
    .commands__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 2.5rem;
    }
  }

  @media (min-width: 1000px) {
    .commands {
      padding-block: 5rem;
    }

    .commands__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .commands__item {
      min-height: 10rem;
      flex-direction: column;
    }

    .commands__item--important {
      min-height: 11rem;
    }
  }
</style>
