---
import { Coffee, ExternalLink } from "@lucide/astro";
import { site } from "../data/site";
---

<section class="support" aria-labelledby="support-title">
  <div class="container">
    <div class="support__card">
      <div class="support__icon" aria-hidden="true">
        <Coffee size={22} stroke-width={2.25} />
      </div>
      <div class="support__content">
        <p class="support__eyebrow">APOYA EL PROYECTO</p>
        <h2 id="support-title">¿Te gusta radioCL?</h2>
        <p>
          radioCL es un proyecto gratuito y open source. Si quieres apoyar su
          desarrollo, puedes invitarme un café.
        </p>
      </div>
      <a
        class="support__link"
        href={site.koFiUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Apoyar radioCL en Ko-fi, abre en una pestaña nueva"
      >
        Apoyar en Ko-fi
        <ExternalLink size={16} stroke-width={2.25} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<style>
  .support {
    padding-block: 4rem;
  }

  .support__card {
    display: grid;
    gap: 1.25rem;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at 92% 18%, rgba(244, 63, 94, 0.11), transparent 34%),
      var(--color-surface);
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .support__icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid rgba(244, 63, 94, 0.25);
    border-radius: 1rem;
    background: rgba(244, 63, 94, 0.09);
    color: var(--color-red);
  }

  .support__eyebrow {
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .support h2 {
    margin-top: 0.5rem;
    color: var(--color-text);
    font-size: clamp(1.75rem, 7vw, 3rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .support__content p:last-child {
    max-width: 42rem;
    margin-top: 0.875rem;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 3vw, 1.125rem);
    line-height: 1.6;
  }

  .support__link {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: fit-content;
    border: 1px solid rgba(244, 63, 94, 0.38);
    border-radius: 999px;
    background: var(--color-red);
    color: var(--color-text);
    padding: 0.875rem 1.125rem;
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1;
    transition:
      background-color var(--transition-interactive),
      border-color var(--transition-interactive),
      transform var(--transition-interactive);
  }

  .support__link:hover {
    background: #fb5771;
    transform: translateY(-1px);
  }

  @media (min-width: 820px) {
    .support {
      padding-block: 5rem;
    }

    .support__card {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 1.5rem;
    }
  }
</style>
