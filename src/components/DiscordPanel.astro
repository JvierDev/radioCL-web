---
import { ChevronDown } from "@lucide/astro";
---

<section class="discord-panel" aria-labelledby="discord-panel-title">
  <div class="container discord-panel__inner">
    <div class="discord-panel__content">
      <p class="discord-panel__eyebrow">PANEL INTERACTIVO</p>
      <h2 id="discord-panel-title">Tu radio, lista en Discord</h2>
      <p>
        Usa <code>/setup</code> para crear este panel en tu servidor y controlar la
        reproducción sin recordar comandos.
      </p>
    </div>

    <div class="discord-panel__preview" aria-label="Vista previa del panel de radioCL en Discord">
      <div class="discord-panel__card">
        <div class="discord-panel__embed">
          <h3><span aria-hidden="true">📻</span> Panel de Control - Radio CL</h3>

          <div class="discord-panel__status-grid">
            <div>
              <p class="discord-panel__label"><span aria-hidden="true">🎵</span> Radio</p>
              <p class="discord-panel__value">ADN</p>
            </div>
            <div>
              <p class="discord-panel__label"><span aria-hidden="true">📊</span> Estado</p>
              <p class="discord-panel__status">
                <span class="discord-panel__status-dot" aria-hidden="true"></span>
                Reproduciendo
              </p>
            </div>
          </div>
        </div>

        <div class="discord-panel__select" aria-hidden="true">
          <span>Selecciona una radio...</span>
          <ChevronDown size={18} stroke-width={2.25} />
        </div>

        <div class="discord-panel__actions" aria-hidden="true">
          <span class="discord-panel__button discord-panel__button--danger">Detener</span>
          <span class="discord-panel__button">Salir</span>
        </div>

        <div class="discord-panel__equalizer" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .discord-panel {
    padding-block: 4rem;
  }

  .discord-panel__inner {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .discord-panel__content {
    min-width: 0;
    max-width: 39rem;
  }

  .discord-panel__eyebrow {
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .discord-panel__content h2 {
    margin-top: 0.875rem;
    color: var(--color-text);
    font-size: clamp(2rem, 8vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .discord-panel__content > p:last-child {
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 3vw, 1.1875rem);
    line-height: 1.6;
  }

  .discord-panel code {
    color: var(--color-cyan);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .discord-panel__preview {
    min-width: 0;
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at 90% 15%, rgba(88, 101, 242, 0.12), transparent 34%),
      var(--color-surface);
    padding: clamp(0.75rem, 3vw, 1.5rem);
  }

  .discord-panel__card {
    position: relative;
    overflow: hidden;
    min-width: 0;
    border: 1px solid #24262d;
    border-radius: 0.875rem;
    background: #1b1c22;
    padding: 0.75rem;
    color: #f4f5f8;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, 0.18);
  }

  .discord-panel__embed {
    width: min(100%, 15.5rem);
    border: 1px solid #373942;
    border-left: 4px solid #22d3a6;
    border-radius: 0.25rem;
    background: #202127;
    padding: 0.75rem;
  }

  .discord-panel__select span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .discord-panel__embed h3 {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: #ffffff;
    font-size: 1rem;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .discord-panel__status-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 0.625rem;
  }

  .discord-panel__label {
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .discord-panel__value,
  .discord-panel__status {
    margin-top: 0.25rem;
    color: #ffffff;
    font-size: 0.875rem;
    line-height: 1.25;
  }

  .discord-panel__value {
    font-weight: 800;
  }

  .discord-panel__status {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .discord-panel__status-dot {
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 999px;
    background: #7fbd5d;
  }

  .discord-panel__select {
    display: flex;
    min-height: 2.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.375rem;
    border: 1px solid #353740;
    border-radius: 0.5rem;
    background: #18191f;
    color: #a9adb8;
    padding: 0.625rem 0.75rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .discord-panel__select :global(svg) {
    flex: 0 0 auto;
    color: #d6d8df;
  }

  .discord-panel__actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .discord-panel__button {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    background: #31323a;
    color: #ffffff;
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 800;
    line-height: 1;
  }

  .discord-panel__button--danger {
    background: #e5394e;
  }

  .discord-panel__equalizer {
    position: absolute;
    right: 0.875rem;
    bottom: 0.875rem;
    display: none;
    align-items: end;
    gap: 0.1875rem;
    height: 1rem;
    opacity: 0.7;
  }

  .discord-panel__equalizer span {
    width: 0.1875rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-cyan);
    animation: equalizer 1.1s ease-in-out infinite;
  }

  .discord-panel__equalizer span:nth-child(2) {
    animation-delay: 0.12s;
  }

  .discord-panel__equalizer span:nth-child(3) {
    animation-delay: 0.24s;
  }

  .discord-panel__equalizer span:nth-child(4) {
    animation-delay: 0.36s;
  }

  @keyframes equalizer {
    0%,
    100% {
      height: 0.35rem;
    }

    50% {
      height: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .discord-panel__equalizer span {
      animation: none;
    }
  }

  @media (max-width: 379px) {
    .discord-panel__status-grid {
      grid-template-columns: 1fr;
      gap: 0.625rem;
    }

    .discord-panel__embed {
      width: 100%;
    }
  }

  @media (min-width: 520px) {
    .discord-panel__card {
      padding: 0.875rem;
    }

    .discord-panel__equalizer {
      display: flex;
    }
  }

  @media (min-width: 900px) {
    .discord-panel {
      padding-block: 5rem;
    }

    .discord-panel__inner {
      grid-template-columns: minmax(0, 0.92fr) minmax(25rem, 1.08fr);
      gap: 4rem;
    }
  }
</style>
