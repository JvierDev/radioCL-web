---
import { Bot, Headphones, Radio } from "@lucide/astro";

const steps = [
  {
    number: "01",
    title: "Añade el bot",
    description: "Invita a radioCL a tu servidor de Discord.",
    Icon: Bot,
  },
  {
    number: "02",
    title: "Únete a un canal",
    description: "Conéctate a cualquier canal de voz.",
    Icon: Headphones,
  },
  {
    number: "03",
    title: "Reproduce una radio",
    description: "Usa /play para elegir tu estación favorita.",
    Icon: Radio,
  },
] as const;
---

<section class="how-it-works" aria-labelledby="how-it-works-title">
  <div class="container">
    <div class="how-it-works__header">
      <p class="how-it-works__eyebrow">CÓMO FUNCIONA</p>
      <h2 id="how-it-works-title">Simple y directo</h2>
      <p>
        Invita a radioCL a tu servidor, conéctate a un canal de voz y comienza a
        escuchar tus radios chilenas favoritas.
      </p>
    </div>

    <div class="how-it-works__steps">
      {
        steps.map((step) => {
          const Icon = step.Icon;

          return (
            <article class="how-it-works__step">
            <div class="how-it-works__icon" aria-hidden="true">
              <Icon size={20} stroke-width={2.25} />
            </div>
            <p class="how-it-works__number">{step.number}</p>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .how-it-works {
    padding-block: 4rem;
  }

  .how-it-works__header {
    max-width: 42rem;
  }

  .how-it-works__eyebrow {
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .how-it-works__header h2 {
    margin-top: 0.875rem;
    color: var(--color-text);
    font-size: clamp(2rem, 8vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .how-it-works__header > p:last-child {
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 3vw, 1.1875rem);
    line-height: 1.6;
  }

  .how-it-works__steps {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .how-it-works__step {
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    background: var(--color-surface);
    padding: 1.25rem;
  }

  .how-it-works__icon {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid rgba(34, 211, 238, 0.25);
    border-radius: 0.875rem;
    background: rgba(34, 211, 238, 0.08);
    color: var(--color-cyan);
  }

  .how-it-works__icon :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .how-it-works__number {
    margin-top: 1.25rem;
    color: var(--color-red);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.16em;
  }

  .how-it-works__step h3 {
    margin-top: 0.375rem;
    color: var(--color-text);
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .how-it-works__step p:last-child {
    margin-top: 0.5rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  @media (min-width: 760px) {
    .how-it-works {
      padding-block: 5rem;
    }

    .how-it-works__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 2.5rem;
    }
  }
</style>
