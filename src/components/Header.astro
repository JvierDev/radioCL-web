---
import { site } from "../data/site";

const navItems = [
  { label: "Inicio", href: "/" },
  { label: "Radios", href: "#radios" },
  { label: "Comandos", href: "#comandos" },
] as const;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/" aria-label="Ir al inicio de radioCL">
      {site.name}
    </a>

    <nav class="site-header__nav" aria-label="Navegación principal">
      {
        navItems.map((item) => (
          <a class="site-header__nav-link" href={item.href}>
            {item.label}
          </a>
        ))
      }
      <a
        class="site-header__nav-link"
        href={site.githubUrl}
        target="_blank"
        rel="noreferrer"
      >
        GitHub
      </a>
    </nav>

    <a class="site-header__cta" href={site.discordInviteUrl}>Añadir a Discord</a>
  </div>
</header>
